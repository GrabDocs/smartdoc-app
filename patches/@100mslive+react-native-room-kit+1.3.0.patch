@@ -0,0 +1,71 @@
+export const EMOJI_REACTION_TYPE = 'EMOJI_REACTION';
+
+/** Same ids the web prebuilt sends. */
+export const EMOJI_REACTION_IDS = [
+  '+1',
+  '-1',
+  'wave',
+  'clap',
+  'fire',
+  'tada',
+  'heart_eyes',
+  'joy',
+  'open_mouth',
+  'sob',
+] as const;
+
+const EMOJI_GLYPH: Record<string, string> = {
+  '+1': '👍',
+  '-1': '👎',
+  wave: '👋',
+  clap: '👏',
+  fire: '🔥',
+  tada: '🎉',
+  heart_eyes: '😍',
+  joy: '😂',
+  open_mouth: '😮',
+  sob: '😭',
+};
+
+export const emojiGlyph = (emojiId: string) => EMOJI_GLYPH[emojiId] || '👍';
+
+export type EmojiReactionPayload = {
+  emojiId: string;
+  senderId?: string;
+};
+
+type Listener = (payload: EmojiReactionPayload) => void;
+
+const listeners = new Set<Listener>();
+
+export function emitEmojiReaction(payload: EmojiReactionPayload) {
+  listeners.forEach((listener) => listener(payload));
+}
+
+export function subscribeEmojiReactions(listener: Listener) {
+  listeners.add(listener);
+  return () => {
+    listeners.delete(listener);
+  };
+}
+
+export function parseEmojiReactionMessage(
+  body: string | undefined
+): { emojiId: string; senderId?: string } | null {
+  if (!body) return null;
+  try {
+    const parsed = JSON.parse(body);
+    if (parsed && typeof parsed.emojiId === 'string') {
+      return {
+        emojiId: parsed.emojiId,
+        senderId: typeof parsed.senderId === 'string' ? parsed.senderId : undefined,
+      };
+    }
+  } catch {
+    // Body may be the emoji id itself.
+  }
+  if (EMOJI_GLYPH[body]) {
+    return { emojiId: body };
+  }
+  return null;
+}
