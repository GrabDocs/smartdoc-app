@@ -0,0 +1,68 @@
+import * as React from 'react';
+import { Animated, StyleSheet, View } from 'react-native';
+
+import { emojiGlyph, subscribeEmojiReactions } from '../utils/emojiReactions';
+
+type Item = {
+  id: number;
+  glyph: string;
+  anim: Animated.Value;
+  left: number;
+};
+
+let nextId = 1;
+
+export const FlyingEmoji = () => {
+  const [items, setItems] = React.useState<Item[]>([]);
+
+  React.useEffect(() => {
+    return subscribeEmojiReactions(({ emojiId }) => {
+      const id = nextId++;
+      const anim = new Animated.Value(0);
+      const left = 20 + (id % 5) * 52;
+      setItems((prev) => [...prev.slice(-14), { id, glyph: emojiGlyph(emojiId), anim, left }]);
+      Animated.timing(anim, {
+        toValue: 1,
+        duration: 2200,
+        useNativeDriver: true,
+      }).start(() => {
+        setItems((prev) => prev.filter((item) => item.id !== id));
+      });
+    });
+  }, []);
+
+  return (
+    <View pointerEvents="none" style={StyleSheet.absoluteFill}>
+      {items.map((item) => {
+        const translateY = item.anim.interpolate({
+          inputRange: [0, 1],
+          outputRange: [0, -240],
+        });
+        const opacity = item.anim.interpolate({
+          inputRange: [0, 0.15, 0.75, 1],
+          outputRange: [0, 1, 1, 0],
+        });
+        return (
+          <Animated.Text
+            key={item.id}
+            pointerEvents="none"
+            style={[
+              styles.emoji,
+              { left: item.left, opacity, transform: [{ translateY }] },
+            ]}
+          >
+            {item.glyph}
+          </Animated.Text>
+        );
+      })}
+    </View>
+  );
+};
+
+const styles = StyleSheet.create({
+  emoji: {
+    position: 'absolute',
+    bottom: 72,
+    fontSize: 36,
+  },
+});
