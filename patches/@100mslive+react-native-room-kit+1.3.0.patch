@@ -0,0 +1,100 @@
+import * as React from 'react';
+import { Modal, Pressable, StyleSheet, Text, View } from 'react-native';
+import { useStore } from 'react-redux';
+import Toast from 'react-native-simple-toast';
+
+import type { RootState } from '../redux';
+import { PressableIcon } from './PressableIcon';
+import {
+  EMOJI_REACTION_IDS,
+  EMOJI_REACTION_TYPE,
+  emojiGlyph,
+  emitEmojiReaction,
+} from '../utils/emojiReactions';
+
+export const HMSEmojiReaction = () => {
+  const [open, setOpen] = React.useState(false);
+  const store = useStore<RootState>();
+
+  const send = async (emojiId: string) => {
+    setOpen(false);
+    const state = store.getState();
+    const senderId = state.hmsStates.localPeer?.peerID;
+    emitEmojiReaction({ emojiId, senderId });
+    const hms = state.user.hmsInstance;
+    if (!hms) return;
+    try {
+      await hms.sendBroadcastMessage(
+        JSON.stringify({ type: EMOJI_REACTION_TYPE, emojiId, senderId }),
+        EMOJI_REACTION_TYPE
+      );
+    } catch (error) {
+      console.log('Emoji reaction failed', error);
+      Toast.show('Could not send reaction');
+    }
+  };
+
+  return (
+    <>
+      <PressableIcon onPress={() => setOpen(true)} accessibilityLabel="Emoji reaction">
+        <Text style={styles.trigger}>😊</Text>
+      </PressableIcon>
+      <Modal
+        visible={open}
+        transparent
+        animationType="fade"
+        onRequestClose={() => setOpen(false)}
+      >
+        <Pressable style={styles.backdrop} onPress={() => setOpen(false)}>
+          <Pressable style={styles.card} onPress={() => {}}>
+            <View style={styles.grid}>
+              {EMOJI_REACTION_IDS.map((emojiId) => (
+                <Pressable
+                  key={emojiId}
+                  style={styles.emojiButton}
+                  onPress={() => send(emojiId)}
+                >
+                  <Text style={styles.emoji}>{emojiGlyph(emojiId)}</Text>
+                </Pressable>
+              ))}
+            </View>
+          </Pressable>
+        </Pressable>
+      </Modal>
+    </>
+  );
+};
+
+const styles = StyleSheet.create({
+  trigger: {
+    fontSize: 18,
+  },
+  backdrop: {
+    flex: 1,
+    justifyContent: 'flex-end',
+    backgroundColor: 'rgba(0,0,0,0.35)',
+    padding: 16,
+    paddingBottom: 96,
+  },
+  card: {
+    alignSelf: 'center',
+    backgroundColor: '#1c1c1e',
+    borderRadius: 16,
+    padding: 12,
+  },
+  grid: {
+    flexDirection: 'row',
+    flexWrap: 'wrap',
+    width: 240,
+    justifyContent: 'center',
+  },
+  emojiButton: {
+    width: 48,
+    height: 48,
+    alignItems: 'center',
+    justifyContent: 'center',
+  },
+  emoji: {
+    fontSize: 28,
+  },
+});
