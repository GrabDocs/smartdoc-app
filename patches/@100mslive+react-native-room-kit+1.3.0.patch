@@ -0,0 +1,77 @@
+import { useCallback } from 'react';
+import { useStore } from 'react-redux';
+import Toast from 'react-native-simple-toast';
+
+import type { RootState } from '../redux';
+import { useHMSActions } from '../hooks-sdk';
+import { isBrbOn, parseMetadata } from './functions';
+
+async function readLocalPeer(store: { getState(): RootState }) {
+  const state = store.getState();
+  const hms = state.user.hmsInstance;
+  if (hms) {
+    try {
+      const latest = await hms.getLocalPeer();
+      if (latest) return latest;
+    } catch (error) {
+      console.log('getLocalPeer failed', error);
+    }
+  }
+  return state.hmsStates.localPeer;
+}
+
+/**
+ * Hand raise and BRB, matching web prebuilt:
+ * read metadata at tap time, merge one field, and use the SDK hand APIs.
+ */
+export function useMeetingToggles() {
+  const hmsActions = useHMSActions();
+  const store = useStore<RootState>();
+
+  const toggleRaiseHand = useCallback(async () => {
+    try {
+      const localPeer = await readLocalPeer(store);
+      const meta = parseMetadata(localPeer?.metadata);
+      if (localPeer?.isHandRaised) {
+        await hmsActions.lowerLocalPeerHand();
+      } else {
+        await hmsActions.raiseLocalPeerHand();
+      }
+      try {
+        if (localPeer?.isHandRaised) {
+          const next = { ...meta, isBRBOn: false as const };
+          delete next.handRaisedAt;
+          await hmsActions.changeMetadata(next);
+        } else {
+          await hmsActions.changeMetadata({
+            ...meta,
+            isBRBOn: false,
+            handRaisedAt: Date.now(),
+          });
+        }
+      } catch (error) {
+        console.log('Hand metadata update failed', error);
+      }
+    } catch (error) {
+      console.log('Raise hand failed', error);
+      Toast.show('Could not change hand raise');
+    }
+  }, [hmsActions, store]);
+
+  const toggleBRB = useCallback(async () => {
+    try {
+      const localPeer = await readLocalPeer(store);
+      const meta = parseMetadata(localPeer?.metadata);
+      const next = !isBrbOn(localPeer?.metadata);
+      await hmsActions.changeMetadata({ ...meta, isBRBOn: next });
+      if (next && localPeer?.isHandRaised) {
+        await hmsActions.lowerLocalPeerHand();
+      }
+    } catch (error) {
+      console.log('BRB toggle failed', error);
+      Toast.show('Could not update Be Right Back');
+    }
+  }, [hmsActions, store]);
+
+  return { toggleRaiseHand, toggleBRB };
+}
