{
  "name": "grabdocs",
  "main": "./index.js",
  "version": "1.0.0",
  "scripts": {
    "eas-build-post-install": "npx patch-package && node scripts/ensure-podfile-extension.js && node scripts/ensure-pbxproj-embed-phase.js && (tr -d '\\r' < scripts/install-extension-profile.sh | bash) || true",
    "start": "expo start",
    "start:tunnel": "expo start --tunnel",
    "start:ios": "expo start --ios",
    "start:offline": "expo start --offline",
    "dev": "node start-expo.js",
    "dev:proxy": "node scripts/proxy-server.js & npm run dev",
    "reset-project": "node ./scripts/reset-project.js",
    "reset-cache": "node ./scripts/reset-cache.js",
    "android": "expo run:android",
    "android:dev": "powershell -ExecutionPolicy Bypass -File ./start-dev.ps1",
    "reload": "powershell -ExecutionPolicy Bypass -File ./reload-app.ps1",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "web-build": "expo build:web",
    "web-serve": "serve web-build",
    "clean": "rm -rf node_modules/.cache",
    "lint": "expo lint",
    "test:bundle": "npx expo export:embed --eager --platform android --dev false",
    "test:bundle:ios": "npx expo export:embed --eager --platform ios --dev false",
    "test:gradle": "node scripts/test-gradle-config.js",
    "preflight": "node scripts/preflight-metro-check.js",
    "verify:extension": "node scripts/verify-extension-config.js",
    "test": "jest",
    "test:all": "npm run preflight && npm run test:gradle && npm run test:bundle",
    "postinstall": "npx patch-package && node scripts/ensure-whatwg-fetch.js"
  },
